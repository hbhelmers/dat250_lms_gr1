POSTGRES_PASSWORD=choose-a-database-password
# Optional: registered teacher for courses created before course memberships.
LMS_LEGACY_TEACHER_EMAIL=

# --- Optional: Supabase PostgreSQL (overrides local Docker Postgres when set) ---
# Use the Supabase Session Pooler (port 5432) so Flyway migrations work smoothly:
# POSTGRES_URL=jdbc:postgresql://aws-0-eu-north-1.pooler.supabase.com:5432/postgres?sslmode=require
# POSTGRES_USER=postgres.<your-project-ref>
# POSTGRES_PASSWORD=<your-supabase-db-password>

# --- Optional: Supabase S3 Storage (overrides local SeaweedFS when set) ---
# Create a private bucket named "lms-submissions" in Supabase Storage and generate S3 Access Keys:
# LMS_STORAGE_ENDPOINT=https://<your-project-ref>.supabase.co/storage/v1/s3
# LMS_STORAGE_REGION=eu-west-1
# LMS_STORAGE_BUCKET=lms-submissions
# LMS_STORAGE_ACCESS_KEY=<your-supabase-s3-access-key>
# LMS_STORAGE_SECRET_KEY=<your-supabase-s3-secret-key>

# Optional: container registry with the images CI builds from main. Set it to deploy without building:
#   docker compose --profile app pull && docker compose --profile app up -d
# D250_REG=git.app.uib.no:4567/hvl-dat-250/26h/semester-project/group-1/dat250_lms_gr1
